# Line ending normalization. The repository stores LF; checkouts keep LF so that
# diffs, CI, and generated files stay identical to the committed bytes.
* text=auto eol=lf

# Rust sources and project configuration
*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Binary assets: never converted or diffed as text
*.ico binary
*.png binary
*.svg text eol=lf
*.ttf binary
*.otf binary
*.exe binary
*.dll binary
*.zip binary
